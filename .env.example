# Base Sepolia deploy settings. Copy to `.env` and fill in. Never commit `.env`.
# Only DEPLOYER_PRIVATE_KEY is required. Empty values count as unset.

# Deploys every contract and holds DEFAULT_ADMIN_ROLE.
DEPLOYER_PRIVATE_KEY=

# Get OPERATOR_ROLE and ISSUER_ROLE. Give an address or a key. Default: the deployer.
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
# Gets ATTESTER_ROLE (signs EIP-712 attestations). Give an address or a key. Default: the deployer.
ATTESTER_ADDRESS=
ATTESTER_PRIVATE_KEY=
# Receives the seedling, verification and fee buckets and carbon sale proceeds. Default: the deployer.
TREASURY_ADDRESS=

# Payment token. Default: Circle test USDC on Base Sepolia (0x036CbD53842c5426634e7929541eC2318f3dCF7e).
USDC_ADDRESS=
# true deploys an open mint and burn MockUSDC instead of using USDC_ADDRESS.
DEPLOY_MOCK_USDC=false

# RPC the deploy forks and broadcasts to. Default: https://sepolia.base.org (rate limited, fine for a deploy).
BASE_SEPOLIA_RPC_URL=
# Verifies on Basescan (free Etherscan V2 key from etherscan.io). Empty: Blockscout instead, no key needed.
ETHERSCAN_API_KEY=

# Optional. ERC-1155 metadata URI template of CarbonLedger.
CARBON_METADATA_URI=

# Demo campaign script (CreateDemoCampaign.s.sol). Broadcasts with OPERATOR_PRIVATE_KEY.
DEMO_TIME_UNIT_SECONDS=180
